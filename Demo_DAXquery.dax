EVALUATE
VAR BaseTable =
    SELECTCOLUMNS (
        HZ_CUST_ACCOUNTS,
        
        /* Customer / Party */
        "CUSTOMER_NUMBER",
            LOOKUPVALUE (
                HZ_PARTIES[PARTY_NUMBER],
                HZ_PARTIES[PARTY_ID], HZ_CUST_ACCOUNTS[PARTY_ID]
            ),

        "CUSTOMER_NAME",
            LOOKUPVALUE (
                HZ_PARTIES[PARTY_NAME],
                HZ_PARTIES[PARTY_ID], HZ_CUST_ACCOUNTS[PARTY_ID]
            ),

        "COUNTY",
            LOOKUPVALUE (
                HZ_PARTIES[COUNTY],
                HZ_PARTIES[PARTY_ID], HZ_CUST_ACCOUNTS[PARTY_ID]
            ),

        /* Customer Account */
        "CUSTOMER_ACCOUNT_NUMBER", HZ_CUST_ACCOUNTS[ACCOUNT_NUMBER],
        "CUSTOMER_ACCOUNT_NAME",   HZ_CUST_ACCOUNTS[ACCOUNT_NAME],
        "ACCOUNT_STATUS_CODE",     HZ_CUST_ACCOUNTS[STATUS],

        /* Lookup decode */
        "ACCOUNT_STATUS",
            LOOKUPVALUE (
                FND_LOOKUP_VALUES_TL[MEANING],
                FND_LOOKUP_VALUES_TL[LOOKUP_CODE], HZ_CUST_ACCOUNTS[STATUS],
                FND_LOOKUP_VALUES_TL[LOOKUP_TYPE], "CODE_STATUS",
                FND_LOOKUP_VALUES_TL[LANGUAGE], "US",
                FND_LOOKUP_VALUES_TL[VIEW_APPLICATION_ID], 0,
                FND_LOOKUP_VALUES_TL[SET_ID], 0
            )
    )

RETURN
    DISTINCT (
        FILTER (
            BaseTable,
            [COUNTY] = "FAIRFAX"
        )
    )

ORDER BY
    [CUSTOMER_NUMBER],
    [CUSTOMER_NAME],
    [CUSTOMER_ACCOUNT_NUMBER],
    [CUSTOMER_ACCOUNT_NAME],
    [ACCOUNT_STATUS_CODE],
    [ACCOUNT_STATUS],
    [COUNTY]
